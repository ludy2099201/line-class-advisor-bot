# ============================================================
# LINE Class Advisor Bot — 補習班 AI 班主任
# 環境變數範本：複製此檔案為 .env 並填入實際值
# ============================================================

# ── LINE Messaging API ──────────────────────────────────────
# 從 LINE Developers Console 取得
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ── Notion API ──────────────────────────────────────────────
# 從 Notion Integration 設定頁取得
NOTION_API_TOKEN=secret_your_notion_integration_token_here

# Notion 資料庫 ID（從資料庫頁面 URL 取得，格式：32 位英數字）
NOTION_DB_FAQ=your_faq_database_id
NOTION_DB_SCHEDULE=your_schedule_database_id
NOTION_DB_HOMEWORK=your_homework_database_id
NOTION_DB_EXAMS=your_exams_database_id
NOTION_DB_LEAVES=your_leaves_database_id
NOTION_DB_LINE_GROUPS=your_line_groups_database_id
NOTION_DB_AI_ALERTS=your_ai_alerts_database_id
NOTION_DB_STAFF=your_staff_database_id
NOTION_DB_CLASSES=your_classes_database_id
NOTION_DB_NOTES=your_notes_database_id

# ── Gemini / LLM ────────────────────────────────────────────
# 正式環境必填；請勿將實際金鑰提交至 Git。
GEMINI_API_KEY=your_gemini_api_key_here
# 依可用模型調整；預設值由 app/config.py 定義。
LLM_MODEL=gemini-3.1-flash-lite

# ── 角色與風險通知對象 ───────────────────────────────────────
# 主要管理員為 production 必填；其他管理員與教職員以逗號分隔 LINE userId。
# 不要填入顯示名稱；未列入 allowlist 的帳號不能使用群組綁定或課後筆記。
ADMIN_LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_LINE_USER_IDS=
STAFF_LINE_USER_IDS=

# ── Redis 低敏感資料快取 ─────────────────────────────────────
# 僅快取 FAQ 與開課班級清單；學生筆記、請假、風險與群組識別資料不進快取。
FAQ_CACHE_TTL_SECONDS=900
CLASS_LIST_CACHE_TTL_SECONDS=300

# ── 背景 webhook worker ──────────────────────────────────────
# web 與 worker service 必須完全相同；整個 event 預設不自動重跑，
# 以避免 LINE reply 或 Notion 寫入在未知部分成功時產生重複 side effect。
WEBHOOK_QUEUE_NAME=line_webhooks
WEBHOOK_JOB_TIMEOUT_SECONDS=120
WEBHOOK_JOB_MAX_RETRIES=0
WEBHOOK_JOB_RETRY_INTERVALS=10,60,300

# ── 補習班基本資訊 ───────────────────────────────────────────
CRAM_SCHOOL_NAME=Moosie 補習班
BOT_NAME=AI班主任

# ── Redis（選填，Railway Redis Plugin 自動注入）──────────────
# 若部署在 Railway 並加入 Redis Plugin，此變數會自動設定
# 未設定時自動退回 In-Memory Session（僅適合單實例）
# REDIS_URL=redis://default:password@host:6379

# ── Session 設定 ─────────────────────────────────────────────
# Session 過期時間（秒），預設 1800（30 分鐘）
# SESSION_TTL_SECONDS=1800

# ── 應用程式設定 ─────────────────────────────────────────────
# production/prod 會強制驗證 LINE、Notion、Gemini、管理員與 Redis 設定。
# 本地開發可保留 development；部署到正式服務時請務必設定 production。
APP_ENV=development
FLASK_DEBUG=false
GENERIC_TIMEZONE=Asia/Taipei
PORT=5000
# 日誌等級（debug / info / warning / error）
LOG_LEVEL=info
# Gunicorn worker 數量（Railway Free tier 建議 2）
WEB_CONCURRENCY=2
